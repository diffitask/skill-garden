{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Skill Atlas: every SKILL.md in a repository, in the terminal.",
  "type": "module",
  "bin": {
    "skill-atlas": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "start": "node src/server.ts",
    "build:web": "node scripts/build-web.ts",
    "test:browser": "node --test tests/browser/*.test.ts"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2"
  }
}
