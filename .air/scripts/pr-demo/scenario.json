{
  "title": "Skill Atlas: scan a repository and read its skills",
  "viewport": { "width": 1280, "height": 800 },
  "steps": [
    { "name": "Landing page", "action": "goto", "url": "/", "note": "The start page: paste a GitHub repository link", "moment": true },
    { "name": "Enter a repository", "action": "type", "selector": "#repository", "value": "https://github.com/demo/skills", "note": "Type a repository link" },
    { "name": "Start the scan", "action": "click", "selector": "#scan", "note": "Click Explore repository" },
    { "name": "Scan results", "action": "wait", "selector": "#results", "focus": "#skills", "note": "Every skill in the repository, sorted by name", "moment": true },
    { "name": "Select a skill", "action": "click", "selector": "#skills button:nth-of-type(2)", "focus": "#detail", "note": "Selecting a skill shows its summary", "moment": true },
    { "name": "Full SKILL.md", "action": "click", "selector": "#full-document summary", "focus": "#full-document", "note": "The original SKILL.md, unchanged", "moment": true },
    { "name": "Back to the top", "action": "scroll", "selector": "#repository" },
    { "name": "Enter a missing repository", "action": "type", "selector": "#repository", "value": "https://github.com/demo/missing", "note": "Now a repository that does not exist" },
    { "name": "Scan it", "action": "click", "selector": "#scan" },
    { "name": "Scan error", "action": "wait", "selector": "#scan-error", "text": "not found", "focus": "#scan-error", "note": "A clear error with a Try again button", "moment": true }
  ]
}
